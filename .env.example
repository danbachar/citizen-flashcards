# ---------------------------------------------------------------------------
# Local development — Postgres in Docker (`npm run db:up`)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://citizen:citizen@localhost:5432/citizen?schema=public"

# ---------------------------------------------------------------------------
# Preview / Production — Neon. Set these in Vercel, not in this file.
#
#   DATABASE_URL  Neon POOLED connection string (host contains "-pooler").
#                 Used by the app at runtime; src/lib/db.ts detects the
#                 *.neon.tech host and switches to the Neon driver adapter.
#
#   DIRECT_URL    Neon DIRECT connection string (no "-pooler"). Used only by
#                 the Prisma CLI, because migrations cannot run through a
#                 connection pooler.
#
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/citizen?sslmode=require"
# DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/citizen?sslmode=require"
# ---------------------------------------------------------------------------
